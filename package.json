{
  "name": "cubespace",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @cubespace/core --filter @cubespace/pad-sim build && pnpm --filter @cubespace/client dev",
    "build": "pnpm -r build",
    "build:win": "dotnet build drivers/win-driver -c Release",
    "check": "pnpm -r --workspace-concurrency=1 check",
    "check:win": "dotnet run --project drivers/win-driver -c Release -- --check-fixtures packages/protocol/fixtures/win"
  }
}
