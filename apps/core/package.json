{
  "name": "@cubespace/core",
  "version": "0.1.0",
  "private": true,
  "description": "CUBE SPACE 상태를 쥐는 상주 프로그램. 패드 · 창 프로그램을 띄우고 client에 상태를 보낸다",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/core.cjs",
    "start": "node dist/core.cjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@cubespace/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
